<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    tools:context="Scrambler.UpdateContactActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Contact Name Input (disabled) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Name"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/contact_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contact name"
            android:inputType="text"
            android:enabled="false"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Key Generation Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Encryption Key Options"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/generate_key_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate New Key Pair"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Handshake Payload Output Area (Uneditable, Selectable) -->
        <TextView
            android:id="@+id/handshake_payload_output"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#EEEEEE"
            android:textColor="#222222"
            android:textIsSelectable="true"
            android:padding="8dp"
            android:gravity="top|start"
            android:scrollbars="vertical"
            android:hint="Generated public key will appear here"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Encryption Key Display/Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Encryption Public Key"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/encryption_key_input"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Generated public key will appear here"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:scrollbars="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Signing Key Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signing Public Key (Optional)"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/signing_key_input"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Paste signing public key here (optional)"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:scrollbars="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Contact"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Delete Button -->
        <Button
            android:id="@+id/delete_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Contact"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>
