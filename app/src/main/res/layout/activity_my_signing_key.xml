<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Scrambler.MySigningKeyActivity">

    <TextView
        android:id="@+id/signing_key_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="top|start"
        android:text="Your public signing key will appear here"
        android:textIsSelectable="true"
        android:background="@android:color/transparent"
        android:padding="16dp"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/generate_signing_key_button"
        app:layout_constraintHeight_min="120dp"
        app:layout_constraintVertical_chainStyle="packed"/>

    <Button
        android:id="@+id/generate_signing_key_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generate new public signing key"
        app:layout_constraintTop_toBottomOf="@id/signing_key_textview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
